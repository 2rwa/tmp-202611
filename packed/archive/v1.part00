<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b1020">
  <title>NEON BREAK — ブロック崩し</title>
  <style>
    :root { color-scheme: dark; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 22px 14px; color: #f1f5ff; background: radial-gradient(ellipse at 50% 0%, #1d2854 0%, #0b1020 58%, #070b16 100%); }
    .shell { width: min(100%, 850px); }
    header { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin: 0 0 18px; }
    h1 { margin: 0; font-size: clamp(1.35rem, 4vw, 2rem); letter-spacing: .11em; font-weight: 850; }
    h1 span { color: #63eeeb; }
    .subtitle { margin: 4px 0 0; color: #9caad0; font-size: .85rem; }
    .scores { display: flex; gap: 10px; }
    .score { background: #19233c; padding: 8px 14px; border: 1px solid #354263; border-radius: 12px; min-width: 80px; text-align: center; }
    .score small { display: block; color: #a7b7d7; font-size: .69rem; letter-spacing: .08em; }
    .score strong { font-variant-numeric: tabular-nums; font-size: 1.12rem; }
    .frame { border: 1px solid #344363; border-radius: 18px; overflow: hidden; background: #0d1529; box-shadow: 0 20px 72px #0006, inset 0 0 0 1px #ffffff0b; }
    canvas { width: 100%; aspect-ratio: 800 / 520; height: auto; display: block; touch-action: none; cursor: crosshair; }
    .bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: space-between; margin-top: 14px; }
    .hint { color: #aab8d7; font-size: .81rem; line-height: 1.6; }
    .controls { display: flex; gap: 8px; }
    button { appearance: none; border: 1px solid #586889; padding: 10px 17px; background: #1d2944; color: #e9f1ff; border-radius: 10px; font-weight: 720; font-size: .86rem; cursor: pointer; }
    button:hover { background: #283857; }
    button.primary { border-color: #77e9de; background: #5adbd4; color: #092331; }
    button.primary:hover { background: #8ff8ed; }
    button:focus-visible { outline: 3px solid #f6d886; outline-offset: 3px; }
    .footer { margin-top: 9px; color: #7989ac; font-size: .76rem; }
    @media (max-width: 620px) { .score { min-width: 70px; padding: 6px 9px; } header { align-items: start; } .bar { justify-content: center; } .hint { text-align: center; width: 100%; } .footer { text-align: center; } }
  </style>
</head>
<body>
  <main class="shell">
    <header>
      <div><h1>NEON <span>BREAK</span></h1><p class="subtitle">ちょっと光るブロック崩し</p></div>
      <div class="scores">
        <div class="score"><small>SCORE</small><strong id="score">0</strong></div>
        <div class="score"><small>BEST</small><strong id="best">0</strong></div>
        <div class="score"><small>LEVEL</small><strong id="level">1</strong></div>
        <div class="score"><small>LIVES</small><strong id="lives">♥ ♥ ♥</strong></div>
      </div>
    </header>
    <div class="frame"><canvas id="game" width="800" height="520" role="img" aria-label="ブロック崩しのゲーム画面。左右キー、マウス、タッチでパドルを操作します。"></canvas></div>
    <div class="bar">
      <div class="hint">← → / A D / マウス・タッチで移動　•　スペースで開始・再開　•　Pで一時停止</div>
      <div class="controls"><button class="primary" id="start">スタート</button><button id="pause">一時停止</button><button id="reset">最初から</button></div>
    </div>
    <div class="footer">全ブロックを消すと次のレベルへ。3回落としたらゲームオーバー。</div>
  </main>
  <script>
  (() => {
    'use strict';
    const canvas = document.querySelector('#game');
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height;
    const els = Object.fromEntries(['score','best','level','lives','start','pause','reset'].map(id => [id, document.getElementById(id)]));
    const colors = ['#54e7de','#57a8ff','#a68cff','#ec83c9','#ffb86f','#f6db82','#7fe6a6'];
    const clamp = (x,a,b) => Math.max(a,Math.min(b,x));
    let best = 0;
    try { best = Number(localStorage.getItem('neonBreakBest')) || 0; } catch (_) {}
    let score=0,level=1,lives=3,state='ready', last=0;
    let left=false,right=false,pointerX=null;
    let particles=[], trails=[];
    const paddle={x:354,y:480,w:92,h:13};
    const ball={x:400,y:467,vx:180,vy:-330,r:7};
    let bricks=[];
    const stars=Array.from({length:48},(_,i)=>({x:(i*173+57)%W,y:(i*101+23)%H,r:i%5===0?1.3:0.75}));

    function syncUI(){
      els.score.textContent=score.toLocaleString('ja-JP');
      els.best.textContent=best.toLocaleString('ja-JP');
      els.level.textContent=level;
      els.lives.textContent='♥ '.repeat(lives).trim() || '—';
      els.start.textContent=state==='playing'?'プレイ中':state==='paused'?'再開':state==='ready'?'スタート':'もう一度';
      els.pause.textContent=state==='paused'?'再開':'一時停止';
    }
    function newBricks(){
      bricks=[];
      const cols=10, rows=Math.min(4+level,7), gap=8, margin=37, bw=(W-margin*2-gap*(cols-1))/cols, bh=24;
      for(let r=0;r<rows;r++) for(let c=0;c<cols;c++) {
        const hp=level>=3&&r===0?2:1;
        bricks.push({x:margin+c*(bw+gap),y:70+r*(bh+9),w:bw,h:bh,hp,maxHp:hp,color:colors[r%colors.length]});
      }
    }
    function resetBall(){
      paddle.x=(W-paddle.w)/2;
      ball.x=paddle.x+paddle.w/2; ball.y=paddle.y-ball.r-2;
      const speed=Math.min(360+level*24,505);
      ball.vx=speed*.48*(Math.random()>.5?1:-1);ball.vy=-Math.sqrt(speed*speed-ball.vx*ball.vx);
      trails=[];
    }
    function restart(){score=0;level=1;lives=3;particles=[];state='ready';newBricks();resetBall();syncUI();}
    function nextLevel(){level++;newBricks();resetBall();state='ready';syncUI();}
    function start(){
      if(state==='playing')return;
      if(state==='gameover'||state==='won')restart();
      state='playing';syncUI();
    }
    function togglePause(){
