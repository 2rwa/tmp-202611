    const stars = Array.from({ length: 48 }, (_, i) => ({ x: (i * 173 + 57) % W, y: (i * 101 + 23) % H, r: i % 5 === 0 ? 1.3 : 0.75 }));

    function syncUI() {
      els.score.textContent = score.toLocaleString('ja-JP');
      els.best.textContent = best.toLocaleString('ja-JP');
      els.level.textContent = level;
      els.lives.textContent = '♥ '.repeat(lives).trim() || '—';
      els.start.textContent = state === 'playing' ? 'プレイ中' : state === 'paused' ? '再開' : state === 'ready' ? 'スタート' : 'もう一度';
      els.pause.textContent = state === 'paused' ? '再開' : '一時停止';
    }

    function updatePaddleShape() {
      paddle.rx = paddle.w / 2;
      paddle.ry = paddle.h / 2;
    }

    function newBricks() {
      bricks = [];
      const cols = 10;
      const rows = Math.min(4 + level, 7);
      const gap = 10;
      const margin = 38;
      const bw = (W - margin * 2 - gap * (cols - 1)) / cols;
      const bh = 28;
      const shapes = ['circle', 'triangle', 'rect'];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const hp = level >= 3 && r === 0 ? 2 : 1;
          bricks.push({
            x: margin + c * (bw + gap),
            y: 70 + r * (bh + 11),
            w: bw,
            h: bh,
            hp,
            maxHp: hp,
            color: colors[(r + c) % colors.length],
            shape: shapes[(r + c + level) % shapes.length]
          });
        }
      }
    }

    function resetBall() {
      paddle.x = (W - paddle.w) / 2;
      ball.x = paddle.x + paddle.w / 2;
      ball.y = paddle.y - ball.r - 6;
      const speed = Math.min(380 + level * 24, 520);
      const angle = -Math.PI / 2 + (level % 2 === 0 ? 0.18 : -0.18);
      ball.vx = Math.cos(angle) * speed;
      ball.vy = Math.sin(angle) * speed;
      trails = [];
    }

    function restart() {
      score = 0;
      level = 1;
      lives = 3;
      particles = [];
      state = 'ready';
      newBricks();
      resetBall();
      syncUI();
    }

    function nextLevel() {
      level++;
      newBricks();
      resetBall();
      state = 'ready';
      syncUI();
    }

    function start() {
      if (state === 'playing') return;
      if (state === 'gameover' || state === 'won') restart();
      state = 'playing';
      syncUI();
    }

    function togglePause() {
      if (state === 'playing') state = 'paused';
      else if (state === 'paused') state = 'playing';
      else if (state === 'ready') state = 'playing';
      syncUI();
    }

    function addScore(points) {
      score += points;
      if (score > best) {
        best = score;
        try { localStorage.setItem('neonBreakBest', String(best)); } catch (_) {}
      }
      syncUI();
    }

    function pop(x, y, color, n = 9) {
      for (let i = 0; i < n; i++) {
        const a = Math.random() * Math.PI * 2;
        const v = 45 + Math.random() * 135;
        particles.push({ x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, t: 0, life: .35 + Math.random() * .35, color });
      }
    }

    function keepBallSpeed(speedTarget) {
      const n = normalize(ball.vx, ball.vy);
      ball.vx = n.x * speedTarget;
      ball.vy = n.y * speedTarget;
    }

    function resolveWallCollision() {
      let bounced = false;
      if (ball.x - ball.r < 8) {
        ball.x = 8 + ball.r;
        const out = reflect(ball.vx, ball.vy, 1, 0);
        ball.vx = out.vx; ball.vy = out.vy;
        bounced = true;
      }
      if (ball.x + ball.r > W - 8) {
        ball.x = W - 8 - ball.r;
        const out = reflect(ball.vx, ball.vy, -1, 0);
        ball.vx = out.vx; ball.vy = out.vy;
        bounced = true;
      }
      if (ball.y - ball.r < 8) {
        ball.y = 8 + ball.r;
        const out = reflect(ball.vx, ball.vy, 0, 1);
        ball.vx = out.vx; ball.vy = out.vy;
        bounced = true;
      }
      if (bounced) keepBallSpeed(Math.min(Math.hypot(ball.vx, ball.vy), 720));
    }

    function collideBallPaddle(prevX, prevY) {
      if (ball.vy <= 0) return false;
      const cx = paddle.x + paddle.w / 2;
      const cy = paddle.y + paddle.h / 2;
      const rx = paddle.rx + ball.r;
      const ry = paddle.ry + ball.r;
      const dx = ball.x - cx;
      const dy = ball.y - cy;
      const inside = (dx * dx) / (rx * rx) + (dy * dy) / (ry * ry) <= 1;
      const wasAbove = prevY <= cy;
      if (!inside || !wasAbove) return false;

      let nx = dx / (rx * rx);
      let ny = dy / (ry * ry);
      let n = normalize(nx, ny);
      if (n.y > -0.08) n = normalize(n.x, -0.22);
      if (n.y > 0) n.y *= -1;

      const out = reflect(ball.vx, ball.vy, n.x, n.y);
      ball.vx = out.vx;
      ball.vy = out.vy;
      if (ball.vy > -70) ball.vy = -70;

      const surfaceScale = 1 / Math.sqrt((dx * dx) / (rx * rx * rx * rx) + (dy * dy) / (ry * ry * ry * ry) || 1);
      const sx = cx + (dx / (rx * rx)) * surfaceScale;
      const sy = cy + (dy / (ry * ry)) * surfaceScale;
      ball.x = sx + n.x * (ball.r + 0.6);
      ball.y = sy + n.y * (ball.r + 0.6);

      const speed = Math.min(Math.hypot(ball.vx, ball.vy) * 1.01, 720);
      keepBallSpeed(speed);
      pop(ball.x, paddle.y + 6, '#69f4e9', 5);
      return true;
    }

    function getRectCollision(b) {
      const nearestX = clamp(ball.x, b.x, b.x + b.w);
      const nearestY = clamp(ball.y, b.y, b.y + b.h);
      const dx = ball.x - nearestX;
      const dy = ball.y - nearestY;
      const dist2 = dx * dx + dy * dy;
      if (dist2 > ball.r * ball.r) return null;

      if (dist2 > 1e-6) {
        const n = normalize(dx, dy);
        return { nx: n.x, ny: n.y, px: nearestX, py: nearestY, penetration: ball.r - Math.sqrt(dist2) + 0.2 };
      }

      const leftPen = Math.abs(ball.x - b.x);
      const rightPen = Math.abs(ball.x - (b.x + b.w));
      const topPen = Math.abs(ball.y - b.y);
      const bottomPen = Math.abs(ball.y - (b.y + b.h));
      const minPen = Math.min(leftPen, rightPen, topPen, bottomPen);
      if (minPen === leftPen) return { nx: -1, ny: 0, px: b.x, py: ball.y, penetration: ball.r + 0.4 };
      if (minPen === rightPen) return { nx: 1, ny: 0, px: b.x + b.w, py: ball.y, penetration: ball.r + 0.4 };
      if (minPen === topPen) return { nx: 0, ny: -1, px: ball.x, py: b.y, penetration: ball.r + 0.4 };
